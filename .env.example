# Example Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Application Settings
APP_ENV=development
APP_DEBUG=false
APP_NAME=Paygate
APP_PORT=3000

# Security
APP_SECRET_KEY=generate-a-secure-random-key-here
JWT_SECRET=generate-a-secure-jwt-secret-here
ENCRYPTION_KEY=generate-a-32-byte-encryption-key-here

# Database Configuration
DB_CONNECTION=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=paygate_dev
DB_USERNAME=paygate_user
DB_PASSWORD=change-this-password

# Redis (for sessions and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-password

# Payment Gateway API (Example)
PAYMENT_GATEWAY_API_URL=https://api.paymentgateway.com
PAYMENT_GATEWAY_API_KEY=your-api-key-here
PAYMENT_GATEWAY_SECRET_KEY=your-secret-key-here
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-secret-here

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@paygate.com
MAIL_FROM_NAME=Paygate

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
AUTH_RATE_LIMIT_PER_MINUTE=5

# Logging
LOG_LEVEL=info
LOG_CHANNEL=daily
LOG_MAX_FILES=14

# Monitoring and Error Tracking
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# Security Headers
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 1 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true

# Feature Flags
FEATURE_MFA_ENABLED=true
FEATURE_FRAUD_DETECTION=true
FEATURE_ANOMALY_DETECTION=true

# Third-party Services
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name

# Vault Configuration (if using HashiCorp Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here

# SSL/TLS Configuration
SSL_CERT_PATH=/path/to/certificate.crt
SSL_KEY_PATH=/path/to/private.key
SSL_CA_PATH=/path/to/ca-bundle.crt
